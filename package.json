{
  "name": "fairscribe",
  "version": "0.1.0",
  "description": "Secure offline speech-to-text exam terminal for candidates requiring a scribe",
  "main": "dist-electron/electron/main.js",
  "private": true,
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "tsc -p tsconfig.json && vite build",
    "seed": "npx ts-node --project tsconfig.node.json scripts/seed.ts",
    "verify-audit": "npx ts-node --project tsconfig.node.json scripts/verify-audit.ts"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "edu.fairscribe.app",
    "productName": "FairScribe",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}
